#!/bin/bash

# Pre-commit hook for vstorm
#
# Install with:
#   git config core.hooksPath hooks
# Or:
#   ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
#
# Runs yamllint on staged plain YAML (same globs as CI lint-yaml; templates/*.yaml
# omitted — not valid YAML for yamllint), markdownlint-cli2 on any staged *.md,
# bats when vstorm / templates / helpers / workload / tests change,
# python3 unittest (monitoring/tests/) when monitoring collector/scripts/tests change,
# and node --test for dashboard-lib.js when static UI helpers change.

set -eu

staged=$(git diff --cached --name-only --diff-filter=d)
[[ -z "$staged" ]] && exit 0

errors=0
run_tests=0
run_py_tests=0
run_js_tests=0
yaml_files=()
md_files=()

while IFS= read -r f; do
    [[ -z "$f" ]] && continue

    # Anywhere under repo: .md / .MD (case does not match paths with newlines)
    if [[ "$f" =~ \.(md|MD)$ ]]; then
        md_files+=("$f")
    fi

    # Same scope as CI lint-yaml (.github/workflows/test.yaml)
    case "$f" in
        helpers/*.yaml|workload/*.yaml|monitoring/yaml/*.yaml|\
        monitoring/tests/fixtures/*.yaml|.github/workflows/*.yaml)
            yaml_files+=("$f") ;;
    esac

    case "$f" in
        vstorm|templates/*|helpers/*|workload/*|tests/*.bats|tests/helpers.bash)
            run_tests=1 ;;
    esac

    case "$f" in
        monitoring/data-collector/*|monitoring/tests/*|monitoring/scripts/*)
            run_py_tests=1 ;;
    esac

    case "$f" in
        monitoring/data-collector/static/*|monitoring/tests/test_dashboard_lib.js)
            run_js_tests=1 ;;
    esac
done <<< "$staged"

if ((run_tests)); then
    if type -p bats &>/dev/null; then
        echo "pre-commit: running bats tests..."
        bats tests/ || { echo "pre-commit: bats FAILED"; errors=$((errors + 1)); }
    else
        echo "pre-commit: WARNING -- bats not found, skipping tests"
    fi
fi

if ((run_py_tests)); then
    if type -p python3 &>/dev/null; then
        echo "pre-commit: running monitoring Python unit tests..."
        python3 -m unittest discover -s monitoring/tests -v \
            || { echo "pre-commit: python unittest FAILED"; errors=$((errors + 1)); }
    else
        echo "pre-commit: WARNING -- python3 not found, skipping monitoring tests"
    fi
fi

if ((run_js_tests)); then
    if type -p node &>/dev/null; then
        echo "pre-commit: running dashboard JS unit tests..."
        node --test monitoring/tests/test_dashboard_lib.js \
            || { echo "pre-commit: node --test FAILED"; errors=$((errors + 1)); }
    else
        echo "pre-commit: WARNING -- node not found, skipping dashboard JS tests"
    fi
fi

if ((${#yaml_files[@]})); then
    if type -p yamllint &>/dev/null; then
        echo "pre-commit: yamllint (${#yaml_files[@]} file(s))..."
        yamllint "${yaml_files[@]}" || { echo "pre-commit: yamllint FAILED"; errors=$((errors + 1)); }
    else
        echo "pre-commit: WARNING -- yamllint not found, skipping YAML lint"
    fi
fi

if ((${#md_files[@]})); then
    if type -p markdownlint-cli2 &>/dev/null; then
        echo "pre-commit: markdownlint-cli2 (${#md_files[@]} file(s))..."
        markdownlint-cli2 "${md_files[@]}" || { echo "pre-commit: markdownlint-cli2 FAILED"; errors=$((errors + 1)); }
    else
        echo "pre-commit: WARNING -- markdownlint-cli2 not found, skipping Markdown lint"
    fi
fi

if ((errors)); then
    echo -e "\npre-commit: $errors check(s) failed -- commit aborted"
    exit 1
fi

echo "pre-commit: all checks passed"
