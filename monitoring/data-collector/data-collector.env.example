# Copy to /etc/vstorm/data-collector.env and adjust.
#   sudo mkdir -p /etc/vstorm /var/lib/vstorm-data-collector
#   sudo cp monitoring/data-collector/data-collector.env.example /etc/vstorm/data-collector.env

# Absolute path to this git checkout (required).
VSTORM_HOME=/home/otus/work/vstorm

# Bind address for the dashboard + ingest API.
LISTEN=0.0.0.0:8080

# SQLite index + raw JSON payloads (persistent across restarts).
DATA_DIR=/var/lib/vstorm-data-collector

# Optional bearer token (leave empty for unauthenticated lab use).
# Must match RESULT_SERVER_TOKEN in vstorm --env and the dashboard token.
TOKEN=
